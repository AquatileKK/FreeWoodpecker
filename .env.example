# 这个文件只是“模板”，不要把真实密钥写在这里。
# 真实密钥只能填到 Netlify 后台：Site configuration -> Environment variables
# 绝对不能写进 public/ 目录下的任何文件（那是公开给所有人的）。

SUPABASE_URL=
# 管理员密钥（Secret key）：最高权限，只能放在这里和 Netlify 后台
SUPABASE_SERVICE_ROLE_KEY=
# 公开密钥（Publishable key，sb_publishable_ 开头）：后台登录要用。绝对不要填成 Secret key
SUPABASE_ANON_KEY=
# 允许登录后台的管理员邮箱，多个用英文逗号隔开，例如 boss@example.com
ADMIN_EMAILS=
